{
  "expo": {
    "name": "E-Wise",
    "slug": "E-Wise",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ewise",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      ["expo-font", { "fonts": [ 
        "./assets/fonts/PlusJakartaSanas-Regular.ttf",
        "./assets/fonts/PlusJakartaSanas-Bold.ttf",
        "./assets/fonts/PlusJakartaSanas-SemiBold.ttf",
        "./assets/fonts/PlusJakartaSanas-Medium.ttf",
        "./assets/fonts/PlusJakartaSanas-ExtraBold.ttf",
        "./assets/fonts/PlusJakartaSanas-Light.ttf"

        ] }]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
